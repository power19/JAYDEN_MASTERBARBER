# ─────────────────────────────────────────────
#  Jayden's Barbershop — WhatsApp Bot Config
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values

# ── Shop Info ──────────────────────────────────
SHOP_NAME=Jayden's Barbershop
SHOP_ADDRESS=Your Street Address, Paramaribo, Suriname
SHOP_PHONE=+597 XXX-XXXX
SHOP_EMAIL=info@jaydensbarbershop.com
SHOP_INSTAGRAM=@jaydensbarbershop
GOOGLE_MAPS_LINK=https://maps.google.com/?q=your+location

# ── Regional Settings ──────────────────────────
CURRENCY=SRD
TIMEZONE=America/Paramaribo

# ── Google Calendar ────────────────────────────
# Calendar ID: found in Google Calendar → Settings → your calendar → Calendar ID
# Use "primary" for your main calendar
GOOGLE_CALENDAR_ID=primary

# Path to your service account JSON key file (see README for how to create it)
GOOGLE_CREDENTIALS_PATH=./credentials/service-account.json

# ── Bot Settings ───────────────────────────────
# How many days ahead customers can book (default: 14)
BOOKING_DAYS_AHEAD=14

# Session timeout in minutes (default: 30)
SESSION_TIMEOUT_MINUTES=30
